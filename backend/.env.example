# Application Settings
APP_NAME=ASHA VoiceCare API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=asha-voicecare-secure-dev-secret-key-32chars

# Database Configuration (PostgreSQL / Supabase, with SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./asha_voicecare.db
# Production Supabase PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Gnani Voice Platform Credentials (NEVER exposed to frontend)
# Prisma v3.0 (STT) & Timbre v3.0 (TTS)
GNANI_API_KEY=
GNANI_ACCESS_TOKEN=
GNANI_PRISMA_WS_URL=wss://api.gnani.ai/prisma/v3/stream
GNANI_TIMBRE_URL=https://api.gnani.ai/timbre/v3/synthesize
GNANI_SIMULATION_MODE=True

# Open-Choice LLM Orchestration
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
